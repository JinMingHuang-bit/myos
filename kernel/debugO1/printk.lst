  80              	void clear_screen(unsigned int FRcolor,unsigned int BKcolor) {
  81              	    int cols = Pos.XResolution / Pos.XCharSize;
  82              	    int rows = Pos.YResolution / Pos.YCharSize;
  83              	    // 遍历所有位置输出空格
  84              	    for (int y = 0; y < rows; y++) {
  85              	        for (int x = 0; x < cols; x++) {
  86              	            putchar(Pos.FB_addr, Pos.XResolution, 
  87              	                   x * Pos.XCharSize, y * Pos.YCharSize,
  88              	                   FRcolor, BKcolor, ' ');
  89              	        }
  90              	    }
  91              	    // 重置光标位置
  92              	    Pos.XPosition = 0;
  93              	    Pos.YPosition = 0;
  94              	}	
  95              			
  96              	
  97              		
  98              	int skip_atoi2(const char **s){
  99              		int i=0;
 100              		while(is_digit(**s)){
 101              			// i=i*10+*((*s)++)-'0';
 102              			char current_char = **s;  // 获取当前字符
 103              			(*s)++;                   // 指针向后移动
 104              			i = i * 10 + (current_char - '0');  // 更新数值
 105              		}
 106              		return i;
 107              	}
 108              	
 109              	int skip_atoi(const char **s){
 110              	 	int i=0;
 111              	 	char current_char;
 112              	 	while(is_digit(current_char = **s)){
 113              	 		(*s)++;                   // 指针向后移动
 114              	 		i = i * 10 + (current_char - '0');  // 更新数值
 115              	 	}
 116              	 	return i;
 117              	}
