     1                                  ; The Unreal Mode testing program 
     2                                  ; For testing in the Bochs emulator 
     3                                  ; NASM Syntax
     4                                  
     5                                  org 0x7c00                  ; BIOS loading address
     6                                  
     7                                  [BITS 16]
     8                                  start:
     9                                      ; Set the segment register
    10 00000000 FA                          cli
    11 00000001 31C0                        xor ax, ax
    12 00000003 8ED8                        mov ds, ax
    13 00000005 8EC0                        mov es, ax
    14 00000007 8ED0                        mov ss, ax
    15 00000009 BC007C                      mov sp, 0x7c00
    16                                  
    17                                      ; Display message indicating entering real mode
    18 0000000C BE[C300]                    mov si, msg_real
    19 0000000F E88400                      call print_string
    20                                  
    21                                  
    22 00000012 BE[DE00]                    mov si, msg_try_high
    23 00000015 E87E00                      call print_string
    24                                  
    25 00000018 6631C0                      xor eax, eax
    26 0000001B B80010                      mov ax, 0x1000          
    27 0000001E 8ED8                        mov ds, ax
    28 00000020 BB0000                      mov bx, 0               
    29 00000023 3E8A07                      mov al, [ds:bx]         
    30                                      
    31 00000026 BE[0301]                    mov si, msg_done
    32 00000029 E86A00                      call print_string
    33                                      
    34 0000002C 8CC8                        mov ax, cs          ;
    35 0000002E 8ED8                        mov ds, ax 
    36                                      ; Enter the main mode
    37 00000030 BE[2D01]                    mov si, msg_unreal
    38 00000033 E86000                      call print_string
    39                                      
    40 00000036 E82800                      call enter_unreal       ; Switch to Unreal Mode
    41                                  
    42                                      ; Now it is in the main mode and you can access 4GB of storage space. 
    43                                      ; Set a test mark at the 2MB position.
    44 00000039 66B800002000                mov eax, 0x200000       ; 2MB address
    45 0000003F 3E67C60055                  mov byte [ds:eax], 0x55 ; Write in the test value
    46                                      
    47                                      ;Then read and display from the 2MB position.
    48 00000044 66B800002000                mov eax, 0x200000
    49 0000004A 3E678A18                    mov bl, [ds:eax]
    50                                      
    51                                      ; displaying results
    52 0000004E BE[4A01]                    mov si, msg_success
    53 00000051 E84200                      call print_string
    54                                      
    55                                      ; Read and display the written value
    56 00000054 BE[6301]                    mov si, msg_value
    57 00000057 E83C00                      call print_string
    58 0000005A 88D8                        mov al, bl
    59 0000005C E84400                      call print_hex_byte
    60                                      
    61                                      ; loop
    62 0000005F EBFE                        jmp $
    63                                  
    64                                  ; Enter the main mode function
    65                                  enter_unreal:
    66 00000061 FA                          cli
    67                                      
    68                                      ; Keep the original DS
    69                                      ; push ds
    70                                      
    71                                      ; Load GDT
    72 00000062 0F0116[9801]                lgdt [gdt_ptr]
    73                                      
    74                                      ; Enter protection mode
    75 00000067 0F20C0                      mov eax, cr0
    76 0000006A 0C01                        or al, 1
    77 0000006C 0F22C0                      mov cr0, eax
    78                                      
    79                                      ; Switch to the refresh pipeline
    80 0000006F EA[7400]0800                jmp 0x08:protect_mode_32
    81                                  
    82                                  [BITS 32]
    83                                  protect_mode_32:
    84                                      ; 加载 4GB 数据段
    85 00000074 66B81000                    mov ax, 0x10
    86 00000078 8ED8                        mov ds, ax
    87 0000007A 8EC0                        mov es, ax
    88 0000007C 8EE0                        mov fs, ax
    89 0000007E 8EE8                        mov gs, ax
    90                                  
    91                                      ; 现在切换到 16 位保护模式，以刷新 CS 缓存中的 D 标志
    92 00000080 EA[87000000]1800            jmp 0x18:protect_mode_16    ; 0x18 指向 GDT 中的 16 位代码段描述符
    93                                  [BITS 16]
    94                                  protect_mode_16:
    95                                      ; 在 16 位保护模式下，CS 缓存中的 D=0，确保后续返回实模式后指令解码正确
    96                                      ; 此时仍然可以访问 4GB 数据（因为 DS 等仍是 4GB 段）
    97                                      ; 返回实模式
    98 00000087 0F20C0                      mov eax, cr0
    99 0000008A 24FE                        and al, 0xFE
   100 0000008C 0F22C0                      mov cr0, eax
   101                                  
   102                                      ; 远跳转回实模式，CS 缓存将保持 D=0（因为是从 16 位保护模式来的）
   103 0000008F EA[9400]0000                jmp 0:real_mode_back
   104                                  
   105                                  real_mode_back:
   106                                      ; Restore SS and SP
   107                                      ; xor ax, ax
   108                                      ; mov ss, ax
   109                                      ; mov sp, 0x7c00
   110                                      
   111                                      ; Restore DS to 0 (but retain the 4GB attribute of the cache)
   112                                      ; pop ds                  ; The original DS = 0
   113                                      
   114 00000094 FB                          sti
   115 00000095 C3                          ret
   116                                  
   117                                  ;Print string function
   118                                  print_string:
   119 00000096 FC                          cld
   120 00000097 AC                          lodsb
   121 00000098 08C0                        or al, al
   122 0000009A 7406                        jz .done
   123 0000009C B40E                        mov ah, 0x0E
   124 0000009E CD10                        int 0x10
   125 000000A0 EBF4                        jmp print_string
   126                                  .done:
   127 000000A2 C3                          ret
   128                                  
   129                                  ; Print hexadecimal bytes
   130                                  print_hex_byte:
   131 000000A3 FC                          cld
   132 000000A4 50                          push ax
   133 000000A5 88C4                        mov ah, al
   134 000000A7 C0E804                      shr al, 4
   135 000000AA E80900                      call print_hex_digit
   136 000000AD 88E0                        mov al, ah
   137 000000AF 240F                        and al, 0x0F
   138 000000B1 E80200                      call print_hex_digit
   139 000000B4 58                          pop ax
   140 000000B5 C3                          ret
   141                                      
   142                                  print_hex_digit:
   143 000000B6 0430                        add al, '0'
   144 000000B8 3C39                        cmp al, '9'
   145 000000BA 7E02                        jle .print
   146 000000BC 0407                        add al, 7
   147                                  .print:
   148 000000BE B40E                        mov ah, 0x0E
   149 000000C0 CD10                        int 0x10
   150 000000C2 C3                          ret
   151                                  
   152                                  ; data segent
   153 000000C3 312E20496E20526561-     msg_real    db '1. In Real Mode (16-bit)', 13, 10, 0
   153 000000CC 6C204D6F6465202831-
   153 000000D5 362D626974290D0A00 
   154 000000DE 322E20547279696E67-     msg_try_high db '2. Trying to access >1MB memory...', 13, 10, 0
   154 000000E7 20746F206163636573-
   154 000000F0 73203E314D42206D65-
   154 000000F9 6D6F72792E2E2E0D0A-
   154 00000102 00                 
   155 00000103 202020285468697320-     msg_done    db '   (This will wrap around in real mode)', 13, 10, 0
   155 0000010C 77696C6C2077726170-
   155 00000115 2061726F756E642069-
   155 0000011E 6E207265616C206D6F-
   155 00000127 6465290D0A00       
   156 0000012D 332E20456E74657269-     msg_unreal  db '3. Entering Unreal Mode...', 13, 10, 0
   156 00000136 6E6720556E7265616C-
   156 0000013F 204D6F64652E2E2E0D-
   156 00000148 0A00               
   157 0000014A 342E20556E7265616C-     msg_success db '4. Unreal Mode active!', 13, 10, 0
   157 00000153 204D6F646520616374-
   157 0000015C 697665210D0A00     
   158 00000163 20202056616C756520-     msg_value   db '   Value at 2MB: 0x', 0
   158 0000016C 617420324D423A2030-
   158 00000175 7800               
   159                                  
   160                                  ; GDT
   161                                  
   162 00000177 90                      align 8
   163                                  gdt:
   164                                      ;NULL descriptor
   165 00000178 0000000000000000            dw 0, 0, 0, 0
   166                                      ; Code segment descriptor (Base address 0, Maximum length 4GB)
   167 00000180 FFFF0000009ACF00            dw 0xFFFF, 0, 0x9A00, 0xCF
   168                                      ; Data segment descriptor (base address 0, limit 4GB)
   169 00000188 FFFF00000092CF00            dw 0xFFFF, 0, 0x9200, 0xCF
   170                                      ; 16 位代码段描述符 (基址0, 限长64KB, D=0) —— 用于返回前刷新 CS 缓存
   171 00000190 FFFF0000009E0000            dw 0xFFFF, 0, 0x9E00, 0x00   ; 注意：限长可设为 64KB，因为不需要访问大内存，只是为了切换模式
   172                                  
   173                                  gdt_ptr:
   174 00000198 1F00                        dw $ - gdt - 1
   175 0000019A [78010000]                  dd gdt
   176                                  
   177                                  ; Fill up to 510 bytes and end with the boot sector flag.
   178 0000019E 00<rep 60h>             times 510-($-$$) db 0
   179 000001FE 55AA                    dw 0xAA55
