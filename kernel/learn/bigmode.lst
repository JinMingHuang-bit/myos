     1                                  ; The Unreal Mode testing program 
     2                                  ; For testing in the Bochs emulator 
     3                                  ; NASM Syntax
     4                                  
     5                                  org 0x7c00                  ; BIOS loading address
     6                                  
     7                                  [BITS 16]
     8                                  start:
     9                                      ; Set the segment register
    10 00000000 FA                          cli
    11 00000001 31C0                        xor ax, ax
    12 00000003 8ED8                        mov ds, ax
    13 00000005 8EC0                        mov es, ax
    14 00000007 8ED0                        mov ss, ax
    15 00000009 BC007C                      mov sp, 0x7c00
    16                                  
    17                                      ; Display message indicating entering real mode
    18 0000000C BE[C800]                    mov si, msg_real
    19 0000000F E88B00                      call print_string
    20                                  
    21                                  
    22 00000012 BE[E300]                    mov si, msg_try_high
    23 00000015 E88500                      call print_string
    24                                  
    25 00000018 6631C0                      xor eax, eax
    26 0000001B B80010                      mov ax, 0x1000          
    27 0000001E 8ED8                        mov ds, ax
    28 00000020 BB0000                      mov bx, 0               
    29 00000023 3E8A07                      mov al, [ds:bx]         
    30                                      
    31 00000026 BE[0801]                    mov si, msg_done
    32 00000029 E87100                      call print_string
    33                                      
    34 0000002C 8CC8                        mov ax, cs          ;
    35 0000002E 8ED8                        mov ds, ax 
    36                                      ; Enter the main mode
    37 00000030 BE[3201]                    mov si, msg_unreal
    38 00000033 E86700                      call print_string
    39                                      
    40 00000036 E82800                      call enter_unreal       ; Switch to Unreal Mode
    41                                  
    42                                      ; Now it is in the main mode and you can access 4GB of storage space. 
    43                                      ; Set a test mark at the 2MB position.
    44 00000039 66B800002000                mov eax, 0x200000       ; 2MB address
    45 0000003F 3E67C60055                  mov byte [ds:eax], 0x55 ; Write in the test value
    46                                      
    47                                      ;Then read and display from the 2MB position.
    48 00000044 66B800002000                mov eax, 0x200000
    49 0000004A 3E678A18                    mov bl, [ds:eax]
    50                                      
    51                                      ; displaying results
    52 0000004E BE[4F01]                    mov si, msg_success
    53 00000051 E84900                      call print_string
    54                                      
    55                                      ; Read and display the written value
    56 00000054 BE[6801]                    mov si, msg_value
    57 00000057 E84300                      call print_string
    58 0000005A 88D8                        mov al, bl
    59 0000005C E84A00                      call print_hex_byte
    60                                      
    61                                      ; loop
    62 0000005F EBFE                        jmp $
    63                                  
    64                                  ; Enter the main mode function
    65                                  enter_unreal:
    66 00000061 FA                          cli
    67                                      
    68                                      ; Keep the original DS
    69                                      ; push ds
    70                                      
    71                                      ; Load GDT
    72 00000062 0F0116[A001]                lgdt [gdt_ptr]
    73                                      
    74                                      ; Enter protection mode
    75 00000067 0F20C0                      mov eax, cr0
    76 0000006A 0C01                        or al, 1
    77 0000006C 0F22C0                      mov cr0, eax
    78                                      
    79                                      ; Switch to the refresh pipeline
    80 0000006F EA[7400]0800                jmp 0x08:protect_mode_32
    81                                  
    82                                  [BITS 32]
    83                                  protect_mode_32:
    84                                      ; 加载 4GB 数据段
    85 00000074 66B81000                    mov ax, 0x10
    86 00000078 8ED8                        mov ds, ax
    87 0000007A 8EC0                        mov es, ax
    88 0000007C 8EE0                        mov fs, ax
    89 0000007E 8EE8                        mov gs, ax
    90                                  
    91                                      ; 现在切换到 16 位保护模式，以刷新 CS 缓存中的 D 标志
    92 00000080 EA[87000000]1800            jmp 0x18:protect_mode_16    ; 0x18 指向 GDT 中的 16 位代码段描述符
    93                                  [BITS 16]
    94                                  protect_mode_16:
    95                                      ; 在 16 位保护模式下，CS 缓存中的 D=0，确保后续返回实模式后指令解码正确
    96                                      ; 此时仍然可以访问 4GB 数据（因为 DS 等仍是 4GB 段）
    97                                      ; 返回实模式
    98 00000087 0F20C0                      mov eax, cr0
    99 0000008A 24FE                        and al, 0xFE
   100 0000008C 0F22C0                      mov cr0, eax
   101                                  
   102                                      ; 远跳转回实模式，CS 缓存将保持 D=0（因为是从 16 位保护模式来的）
   103 0000008F EA[9400]0000                jmp 0:real_mode_back
   104                                  
   105                                  real_mode_back:
   106                                      ; Restore SS and SP
   107 00000094 31C0                        xor ax, ax
   108 00000096 8ED0                        mov ss, ax
   109 00000098 BC007C                      mov sp, 0x7c00
   110                                      
   111                                      ; Restore DS to 0 (but retain the 4GB attribute of the cache)
   112                                      ; pop ds                  ; The original DS = 0
   113                                      
   114 0000009B FB                          sti
   115 0000009C C3                          ret
   116                                  
   117                                  ;Print string function
   118                                  print_string:
   119 0000009D AC                          lodsb
   120 0000009E 08C0                        or al, al
   121 000000A0 7406                        jz .done
   122 000000A2 B40E                        mov ah, 0x0E
   123 000000A4 CD10                        int 0x10
   124 000000A6 EBF5                        jmp print_string
   125                                  .done:
   126 000000A8 C3                          ret
   127                                  
   128                                  ; Print hexadecimal bytes
   129                                  print_hex_byte:
   130 000000A9 50                          push ax
   131 000000AA 88C4                        mov ah, al
   132 000000AC C0E804                      shr al, 4
   133 000000AF E80900                      call print_hex_digit
   134 000000B2 88E0                        mov al, ah
   135 000000B4 240F                        and al, 0x0F
   136 000000B6 E80200                      call print_hex_digit
   137 000000B9 58                          pop ax
   138 000000BA C3                          ret
   139                                      
   140                                  print_hex_digit:
   141 000000BB 0430                        add al, '0'
   142 000000BD 3C39                        cmp al, '9'
   143 000000BF 7E02                        jle .print
   144 000000C1 0407                        add al, 7
   145                                  .print:
   146 000000C3 B40E                        mov ah, 0x0E
   147 000000C5 CD10                        int 0x10
   148 000000C7 C3                          ret
   149                                  
   150                                  ; data segent
   151 000000C8 312E20496E20526561-     msg_real    db '1. In Real Mode (16-bit)', 13, 10, 0
   151 000000D1 6C204D6F6465202831-
   151 000000DA 362D626974290D0A00 
   152 000000E3 322E20547279696E67-     msg_try_high db '2. Trying to access >1MB memory...', 13, 10, 0
   152 000000EC 20746F206163636573-
   152 000000F5 73203E314D42206D65-
   152 000000FE 6D6F72792E2E2E0D0A-
   152 00000107 00                 
   153 00000108 202020285468697320-     msg_done    db '   (This will wrap around in real mode)', 13, 10, 0
   153 00000111 77696C6C2077726170-
   153 0000011A 2061726F756E642069-
   153 00000123 6E207265616C206D6F-
   153 0000012C 6465290D0A00       
   154 00000132 332E20456E74657269-     msg_unreal  db '3. Entering Unreal Mode...', 13, 10, 0
   154 0000013B 6E6720556E7265616C-
   154 00000144 204D6F64652E2E2E0D-
   154 0000014D 0A00               
   155 0000014F 342E20556E7265616C-     msg_success db '4. Unreal Mode active!', 13, 10, 0
   155 00000158 204D6F646520616374-
   155 00000161 697665210D0A00     
   156 00000168 20202056616C756520-     msg_value   db '   Value at 2MB: 0x', 0
   156 00000171 617420324D423A2030-
   156 0000017A 7800               
   157                                  
   158                                  ; GDT
   159                                  
   160 0000017C 90<rep 4h>              align 8
   161                                  gdt:
   162                                      ;NULL descriptor
   163 00000180 0000000000000000            dw 0, 0, 0, 0
   164                                      ; Code segment descriptor (Base address 0, Maximum length 4GB)
   165 00000188 FFFF0000009ACF00            dw 0xFFFF, 0, 0x9A00, 0xCF
   166                                      ; Data segment descriptor (base address 0, limit 4GB)
   167 00000190 FFFF00000092CF00            dw 0xFFFF, 0, 0x9200, 0xCF
   168                                      ; 16 位代码段描述符 (基址0, 限长64KB, D=0) —— 用于返回前刷新 CS 缓存
   169 00000198 FFFF0000009E0000            dw 0xFFFF, 0, 0x9E00, 0x00   ; 注意：限长可设为 64KB，因为不需要访问大内存，只是为了切换模式
   170                                  
   171                                  gdt_ptr:
   172 000001A0 1F00                        dw $ - gdt - 1
   173 000001A2 [80010000]                  dd gdt
   174                                  
   175                                  ; Fill up to 510 bytes and end with the boot sector flag.
   176 000001A6 00<rep 58h>             times 510-($-$$) db 0
   177 000001FE 55AA                    dw 0xAA55
