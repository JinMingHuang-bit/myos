   6              	void putchar(unsigned int *fb,int Xsize,int x,int y,unsigned int FRcolor,unsigned int BKcolor,unsig
   7              		int i=0;
   8              		int j=0;
   9              		unsigned int *addr = NULL;
  10              		unsigned char *fontp = NULL;
  11              		int testval=0;
  12              		fontp=font_ascii[font];
  13              		for(i=0;i<16;i++){
  14              		//Shift the mask one position to the right. After the first cycle, it becomes 0x80, then 0x40, 0x2
  15              			addr=fb+Xsize*(y+i)+x;
  16              			testval =0x100;
  17              			for(j=0;j<8;j++){
  18              				testval =testval >>1;
  19              				if(*fontp & testval){
GAS LISTING printk.s 			page 14


  20              					*addr =FRcolor;
  21              				}else{
  22              					*addr =BKcolor;
  23              				}
  24              				addr++;
  25              			}
  26              			fontp++;
  27              		}
  28              	}
