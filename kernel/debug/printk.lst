 185:lib.h         ****         "cld \n\t"
 186:lib.h         ****         "repe \n\t"
 187:lib.h         ****         "cmpsb \n\t"
 188:lib.h         ****         "jne 1f \n\t"
 189:lib.h         ****         "xorl %%eax, %%eax \n\t"  // 相等
 190:lib.h         ****         "jmp 2f \n\t"
 191:lib.h         ****         "1: \n\t"
