  30              	int color_printk(unsigned int FRcolor,unsigned int BKcolor,const char *fmt,...){
  31              		int i=0;
  32              		int count=0;
  33              		int line=0;
  34              		va_list args;
  35              		va_start(args,fmt);	
  36              		i=vsprintf(buf,fmt,args);
  37              		va_end(args);
  38              		for(count=0;count<i || line;count++){
  39              			if(line >0){
  40              				count--;
  41              				goto Label_tab;
  42              			}
  43              			if((unsigned char)*(buf+count)=='\n'){
  44              				Pos.YPosition++;
  45              				Pos.XPosition=0;
  46              			}else if((unsigned char)*(buf+count)=='\b'){
  47              				Pos.XPosition--;
  48              				if(Pos.XPosition<0){
  49              					Pos.XPosition=(Pos.XResolution/ Pos.XCharSize-1)*Pos.XCharSize;
  50              					Pos.YPosition--;
  51              					if(Pos.YPosition<0){
  52              						Pos.YPosition=(Pos.YResolution/ Pos.YCharSize-1)*Pos.YCharSize;
  53              				}
  54              				}
  55              				putchar(Pos.FB_addr,Pos.XResolution,Pos.XPosition*Pos.XCharSize,Pos.YPosition*Pos.YCharSize,FRco
  56              			}else if((unsigned char)*(buf+count)=='\t'){
  57              				//~7 的二进制是 11111000（假设8位）
  58              				//清除低3位（因为8=2³），实现8字节边界对齐
  59              					line =((Pos.XPosition+8)& ~(8-1))-Pos.XPosition;
  60              				Label_tab:
  61              					line--;
  62              					putchar(Pos.FB_addr,Pos.XResolution,Pos.XPosition*Pos.XCharSize,Pos.YPosition*Pos.YCharSize,FRc
  63              					Pos.XPosition++;
  64              			}else{
  65              				putchar(Pos.FB_addr,Pos.XResolution,Pos.XPosition*Pos.XCharSize,Pos.YPosition*Pos.YCharSize,FRco
  66              				Pos.XPosition++;
  67              			}
  68              			if(Pos.XPosition>=(Pos.XResolution/Pos.XCharSize)){
  69              				Pos.YPosition++;
  70              				Pos.XPosition=0;
  71              		}
  72              			if(Pos.YPosition>=(Pos.YResolution/Pos.YCharSize)){
  73              				Pos.YPosition=0;
  74              			}
  75              	}
  76              	return i;
GAS LISTING printk.s 			page 15


  77              	}
  78              	
  79              	
  80              	void clear_screen(unsigned int FRcolor,unsigned int BKcolor) {
  81              	    int cols = Pos.XResolution / Pos.XCharSize;
  82              	    int rows = Pos.YResolution / Pos.YCharSize;
  83              	    // 遍历所有位置输出空格
  84              	    for (int y = 0; y < rows; y++) {
  85              	        for (int x = 0; x < cols; x++) {
  86              	            putchar(Pos.FB_addr, Pos.XResolution, 
  87              	                   x * Pos.XCharSize, y * Pos.YCharSize,
  88              	                   FRcolor, BKcolor, ' ');
  89              	        }
  90              	    }
  91              	    // 重置光标位置
  92              	    Pos.XPosition = 0;
  93              	    Pos.YPosition = 0;
  94              	}	
