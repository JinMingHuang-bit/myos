  16:gate.h        **** // set the interrupt gate
  17:gate.h        **** /*
  18:gate.h        **** 这个宏函数用于设置x86-64架构的中断门描述符(Interrupt Gate Descriptor)
  19:gate.h        **** 参数说明：
  20:gate.h        **** - gate_selector_addr: 中断门描述符的内存地址
  21:gate.h        **** - attr: 中断门的属性位
  22:gate.h        **** - ist: 中断栈表索引
  23:gate.h        **** - code_addr: 中断处理程序的代码地址
  24:gate.h        **** 
  25:gate.h        **** x86-64中断门描述符格式（16字节）：
  26:gate.h        **** +0-7字节：低64位 - 包含代码地址的0-31位、段选择子、IST等
  27:gate.h        **** +8-15字节：高64位 - 包含代码地址的32-63位、属性等
  28:gate.h        **** */
  29:gate.h        **** 
  30:gate.h        **** #define _set_gate(gate_selector_addr, attr, ist, code_addr) \
  31:gate.h        **** do \
  32:gate.h        **** { \
  33:gate.h        ****     unsigned long __d0, __d1; \
  34:gate.h        ****     __asm__ __volatile__( \
  35:gate.h        ****         "movw %%dx, %%ax  \n\t"          /* 将dx(段选择子)移到ax */ \
  36:gate.h        ****         "andq $0x7, %%rcx \n\t"          /* 保留IST的低3位 */ \
  37:gate.h        ****         "addq %4, %%rcx   \n\t"           \
  38:gate.h        ****         "shlq $32, %%rcx  \n\t"          /* 左移32位准备高位 */ \
  39:gate.h        ****         "addq %%rcx, %%rax \n\t"         /* 合并到rax */ \
  40:gate.h        ****         "xorq %%rcx, %%rcx \n\t"         /* 清空rcx */ \
  41:gate.h        ****         "movl %%edx, %%ecx \n\t"         /* 将edx低32位移到ecx */ \
  42:gate.h        ****         "shrq $16, %%rcx  \n\t"          /* 右移16位获取高16位 */ \
  43:gate.h        ****         "shlq $48, %%rcx  \n\t"          /* 左移48位到最高位 */ \
  44:gate.h        ****         "addq %%rcx, %%rax \n\t"         /* 添加到rax */ \
