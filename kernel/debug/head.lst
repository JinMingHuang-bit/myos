   9              	_start:
  10              	/*2. 为什么是 0x10 ？
  11              	0x10 （二进制 0001_0000 ）的解析如下：
  12              	
  13              	Index： 0001_0 （即 2 ），表示选择 GDT 中的第 3 个描述符（索引从 0 开始）。
  14              	TI： 0 ，表示使用 GDT。
  15              	RPL： 00 ，表示内核模式（最高特权）。
  16              	在操作系统的启动阶段，GDT 通常被初始化为包含以下条目：
  17              	
  18              	NULL 描述符（索引 0）：保留，通常为全 0。
  19              	内核代码段描述符（索引 1）：用于内核代码执行。
  20              	内核数据段描述符（索引 2）：用于内核数据访问。
  21              	因此， 0x10 选择的是 GDT 中的 内核数据段描述符，确保内核代码可以正确访
  22              	*/
  23 0000 66B81000 		mov	$0x10,	%ax
  24 0004 8ED8     		mov	%ax,	%ds
  25 0006 8EC0     		mov	%ax,	%es
  26 0008 8EE0     		mov	%ax,	%fs
  27 000a 8ED0     		mov	%ax,	%ss
  28 000c BC007E00 		mov	$0x7E00,	%esp
  28      00
