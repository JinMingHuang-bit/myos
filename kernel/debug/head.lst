   8              	_start:
   9              	/*2. 为什么是 0x10 ？
  10              	0x10 （二进制 0001_0000 ）的解析如下：
  11              	
  12              	Index： 0001_0 （即 2 ），表示选择 GDT 中的第 3 个描述符（索引从 0 开始）。
  13              	TI： 0 ，表示使用 GDT。
  14              	RPL： 00 ，表示内核模式（最高特权）。
  15              	在操作系统的启动阶段，GDT 通常被初始化为包含以下条目：
  16              	
  17              	NULL 描述符（索引 0）：保留，通常为全 0。
  18              	内核代码段描述符（索引 1）：用于内核代码执行。
  19              	内核数据段描述符（索引 2）：用于内核数据访问。
  20              	因此， 0x10 选择的是 GDT 中的 内核数据段描述符，确保内核代码可以正确访
  21              	*/
  22 0000 66B81000 		mov	$0x10,	%ax
  23 0004 8ED8     		mov	%ax,	%ds
  24 0006 8EC0     		mov	%ax,	%es
  25 0008 8EE0     		mov	%ax,	%fs
  26 000a 8ED0     		mov	%ax,	%ss
  27 000c BC007E00 		mov	$0x7E00,	%esp
  27      00
  28              	
  29              	//=======	load GDTR
  30              	
  31 0011 0F011500 		lgdt	GDT_POINTER(%rip)
  31      000000
  32              	
  33              	//=======	load	IDTR
  34              	
  35 0018 0F011D00 		lidt	IDT_POINTER(%rip)
  35      000000
  36              	
  37 001f 66B81000 		mov	$0x10,	%ax
  38 0023 8ED8     		mov	%ax,	%ds
  39 0025 8EC0     		mov	%ax,	%es
  40 0027 8EE0     		mov	%ax,	%fs
  41 0029 8EE8     		mov	%ax,	%gs
  42 002b 8ED0     		mov	%ax,	%ss
  43              	
  44 002d 48C7C400 		movq	$0x7E00,	%rsp
  44      7E0000
  45              	
  46              	//=======	load	cr3
  47              	
