   3:memory.h      **** //The number of page table entries. 
   4:memory.h      **** //In 64-bit mode, each page table entry occupies 8 bytes, so a page table can accommodate up to 512
   5:memory.h      **** #define PTRS_PER_PAGE 512
   6:memory.h      **** /*
   7:memory.h      **** This macro defines the starting virtual address of the kernel space. On the x86_64 architecture, th
   8:memory.h      **** used to directly map physical memory to the kernel virtual address space.
   9:memory.h      **** */
  10:memory.h      **** #define PAGE_OFFSET ((unsigned long)0xffff800000000000)
  11:memory.h      **** /* 
  12:memory.h      **** Address translation process:
  13:memory.h      **** 1. CR3 register → Physical base address of PML4
  14:memory.h      **** 2. PML4 index → Find the physical address of PDPT in PML4
  15:memory.h      **** 3. PDPT index → Find the physical address of PD in PDPT
  16:memory.h      **** 4. PD index → Find the physical address of PT in PD
  17:memory.h      **** 5. PT index → Find the physical page frame address in PT
  18:memory.h      **** 6. Offset → Specific location in the physical address
  19:memory.h      **** 
  20:memory.h      **** In the x86_64 architecture, the standard 48-bit virtual address layout is as follows:
  21:memory.h      **** 
  22:memory.h      **** 47               39 38               30 29               21 20               12 11        0
  23:memory.h      **** ┌────────────────┬───────────────
  24:memory.h      **** │PML4 indexes    │PDPT indexes    │PD   indexes    │     PT   indexs|     offset      │
  25:memory.h      **** │    (9 bits)    │    (9 bits)    │    (9 bits)    │    (9 bits)    │    (12 bits)    │
  26:memory.h      **** └────────────────┴───────────────
  27:memory.h      ****        ↑                 ↑                 ↑                 ↑                ↑
  28:memory.h      ****       47-39            38-30             29-21             20-12            11-0
  29:memory.h      **** 
  30:memory.h      **** 	Therefore, in order to extract the top 9 bits (the PML4 index) from the 64-bit virtual address, it
  31:memory.h      **** The following code is similar
  32:memory.h      **** */
  33:memory.h      **** #define PAGE_GDT_SHIFT 39
  34:memory.h      **** #define PAGE_1G_SHIFT 30
  35:memory.h      **** #define PAGE_2M_SHIFT 21
  36:memory.h      **** // 2 raised to the power of 12 equals 4096, which is 4k. 
  37:memory.h      **** //These are the physical page capacities represented by each page table entry.
  38:memory.h      **** #define PAGE_4K_SHIFT 12
  39:memory.h      **** //1UL：Unsigned long integer constant 1 (64 bits)
  40:memory.h      **** //2,097,152,即2M
  41:memory.h      **** #define PAGE_2M_SIZE (1UL << PAGE_2M_SHIFT)
  42:memory.h      **** //1UL << 12 = 4,096 = 4KB。
  43:memory.h      **** #define PAGE_4K_SIZE (1UL << PAGE_4K_SHIFT)
  44:memory.h      **** /*
GAS LISTING memory.s 			page 2


  45:memory.h      **** This mask, when performing a "AND" operation with any address, will clear the lower 21 bits of the 
  46:memory.h      **** thereby obtaining the starting address of the 2MB page where the address is located (2MB alignment)
  47:memory.h      **** */
  48:memory.h      **** #define PAGE_2M_MASK (~(PAGE_2M_SIZE - 1))
  49:memory.h      **** #define PAGE_4K_MASK (~(PAGE_4K_SIZE - 1))
  50:memory.h      **** 
  51:memory.h      **** /* 
  52:memory.h      **** set a = q·s + r，among 0 ≤ r < s（r is the remainder）
  53:memory.h      **** 
  54:memory.h      **** s (Page Size): Page Size
  55:memory.h      **** s = PAGE_2M_SIZE or s = PAGE_4K_SIZE 
  56:memory.h      **** This is the reference unit we need to align with. 
  57:memory.h      **** For example: PAGE_4K_SIZE = 4096 (bytes) 
  58:memory.h      **** q (Quotient): Quotient
  59:memory.h      **** q = floor(a / s), which is the integer quotient obtained by dividing the address a by the page size
  60:memory.h      **** Indicates the total number of complete pages that were already included before address a. 
  61:memory.h      **** r (Remainder): Remainder
  62:memory.h      **** r = a % s, which means the remainder obtained when the address a is divided by the page size. 
  63:memory.h      **** Indicates the offset of address a beyond the last complete page
  64:memory.h      ****  
  65:memory.h      **** situation 1: r = 0（Alignment completed）
  66:memory.h      **** (a + s - 1) & ~(s-1) 
  67:memory.h      **** = (q·s + s - 1) & ~(s-1)
  68:memory.h      **** = ((q+1)·s - 1) & ~(s-1)
  69:memory.h      **** = q·s   
  70:memory.h      **** Because the lower log₂(s) bits of (q + 1)·s - 1 are all 1 (for example, when 4KB alignment is us
  71:memory.h      **** after performing an AND operation with ~(s - 1) (a mask with the lower log₂(s) bits being 0), 
  72:memory.h      **** these lower bits are cleared, and the result becomes q·s
  73:memory.h      **** 
  74:memory.h      ****  "Low log₂(s) bits" meaning:
  75:memory.h      **** In binary representation, the "low log₂(s) bits" refer to the lowest log₂(s) bits of a binary n
  76:memory.h      **** Taking 4KB alignment as an example (s = 4096 = 2¹²):
  77:memory.h      **** s-1 = 4095 = binary : 00000000000000000000111111111111
  78:memory.h      ****                                           ↑low 12 bits↑
  79:memory.h      **** In the binary representation of 4095, the lower 12 bits are all 1. 
  80:memory.h      **** So, "low log₂(4096) = 12 bits" means that these are the lowest 12 binary digits of this number.
  81:memory.h      **** situation 2: r > 0（not alignment）
  82:memory.h      **** (a + s - 1) & ~(s-1)
  83:memory.h      **** = (q·s + r + s - 1) & ~(s-1)
  84:memory.h      **** = ((q+1)·s + (r-1)) & ~(s-1)
  85:memory.h      **** = (q+1)·s  
  86:memory.h      **** // Because r - 1 < s - 1, after clearing the lower bits, we obtain (q + 1)·s
  87:memory.h      **** */
  88:memory.h      **** #define PAGE_2M_ALIGN(addr) (((unsigned long)(addr) + PAGE_2M_SIZE - 1) & PAGE_2M_MASK)
  89:memory.h      **** #define PAGE_4K_ALIGN(addr) (((unsigned long)(addr) + PAGE_4K_SIZE - 1) & PAGE_4K_MASK)
  90:memory.h      **** #define Virt_To_Phy(addr) ((unsigned long)(addr) - PAGE_OFFSET)
  91:memory.h      **** #define Phy_To_Virt(addr) ((unsigned long*)((unsigned long)(addr) + PAGE_OFFSET))
  92:memory.h      **** /*
  93:memory.h      **** Address space diagram (aligned at 4KB):
  94:memory.h      **** 0x0000 ┌─────────────┐ ← Page border (q·s)
  95:memory.h      ****        │  page 0     │
  96:memory.h      **** 0x1000 ├─────────────┤ ← Next page border ((q+1)·s)
  97:memory.h      ****        │  page 1     │
  98:memory.h      **** 0x2000 ├─────────────┤
  99:memory.h      ****        │  page 2     │
 100:memory.h      ****        └─────────────┘
 101:memory.h      **** if the address a=0x1234：
GAS LISTING memory.s 			page 3


 102:memory.h      **** a = 0x1234（Inside page 0, but not on the boundary.）
 103:memory.h      **** after alignment = 0x2000（Next page boundary）
 104:memory.h      **** */
