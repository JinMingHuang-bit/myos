 255:lib.h         ****         p1++;
 256:lib.h         ****         p2++;
 257:lib.h         ****     }
 258:lib.h         ****     
 259:lib.h         ****     // 所有字节都相等
 260:lib.h         ****     return 0;
 261:lib.h         **** }
