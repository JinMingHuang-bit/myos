 4123              	# memory.c:225: 		*(memory_management_struct.bits_map+((p->PHY_address>>PAGE_2M_SHIFT)>>6))^=1UL <<
 175:memory.c      **** 
 176:memory.c      **** /*
 177:memory.c      **** 		步骤1：计算页面编号（Page Number）
 178:memory.c      **** c
 179:memory.c      **** unsigned long page_number = p->PHY_address >> PAGE_2M_SHIFT;
 180:memory.c      **** 物理地址右移21位（因为2MB = 2^21字节）
 181:memory.c      **** 
 182:memory.c      **** 得到页面在全局中的索引号
 183:memory.c      **** 步骤2：计算位图数组索引（word_index）
 184:memory.c      **** c
 185:memory.c      **** unsigned long word_index = page_number >> 6;  // 等价于 page_number / 64
 186:memory.c      **** 每个 unsigned long 有64位（64位系统）
 187:memory.c      **** 
 188:memory.c      **** 一个 unsigned long 可以管理64个页面
 189:memory.c      **** 步骤3：计算位偏移（bit_offset）
 190:memory.c      **** c
 191:memory.c      **** unsigned long bit_offset = page_number % 64;
 192:memory.c      **** 页面在位图 unsigned long 中的具体位置
 193:memory.c      **** 
 194:memory.c      **** 示例
 195:memory.c      **** 
 196:memory.c      **** text
 197:memory.c      **** page_number = 129
 198:memory.c      **** bit_offset = 129 % 64 = 1 (第1位，从0开始计数)
 199:memory.c      **** 
 200:memory.c      **** 步骤4：构造位掩码并应用异或操作
 201:memory.c      **** c
 202:memory.c      **** 1UL << bit_offset  // 创建一个掩码，只有bit_offset位为1
 203:memory.c      **** ^=                 // 异或操作，翻转特定位
 204:memory.c      **** 完整计算过程：
 205:memory.c      **** 
 206:memory.c      **** text
 207:memory.c      **** 假设：
 208:memory.c      **** bits_map地址 = 0x12346000
 209:memory.c      **** page_number = 129
 210:memory.c      **** 
 211:memory.c      **** 计算：
 212:memory.c      **** 1. word_index = 129 >> 6 = 2
 213:memory.c      **** 2. 位图位置 = bits_map + 2 = 0x12346000 + 2*8 = 0x12346010
 214:memory.c      **** 3. bit_offset = 129 % 64 = 1
 215:memory.c      **** 4. 掩码 = 1UL << 1 = 0x2 (二进制 10)
 216:memory.c      **** 5. 异或操作：bits_map[2] ^= 0x2
 217:memory.c      **** 
 218:memory.c      **** 4. 为什么使用异或操作（^=）？
 219:memory.c      **** 背景：
 220:memory.c      **** 
 221:memory.c      **** 位图初始化为全1（0xFF）：所有页面标记为"已占用"
 222:memory.c      **** 
 223:memory.c      **** 可用页面需要标记为"空闲"（0）
 224:memory.c      **** 		 */		
