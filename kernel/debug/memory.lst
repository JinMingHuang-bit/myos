  67:memory.h      **** 
  68:memory.h      **** //Mark the ordinary memory area
  69:memory.h      **** #define ZONE_NORMAL	(1 << 1) //2
  70:memory.h      **** 
  71:memory.h      **** //Mark the unmapped or high-end memory regions
  72:memory.h      **** #define ZONE_UNMAPED	(1 << 2) // 4
  73:memory.h      **** 
  74:memory.h      **** ////struct page attribute (alloc_pages flags)
  75:memory.h      **** 
  76:memory.h      **** //The page has been mapped to the page table.
  77:memory.h      **** #define PG_PTable_Maped	(1 << 0) //1
  78:memory.h      **** 
  79:memory.h      **** //Kernel initialization page
  80:memory.h      **** #define PG_Kernel_Init	(1 << 1) //2
  81:memory.h      **** 
  82:memory.h      **** 
  83:memory.h      **** //The page has been accessed recently.
  84:memory.h      **** #define PG_Referenced	(1 << 2)  //4
  85:memory.h      **** 
  86:memory.h      **** //The page has been modified (dirty page)
  87:memory.h      **** #define PG_Dirty	(1 << 3)  //8
  88:memory.h      **** 
  89:memory.h      **** //Active page (in the active LRU linked list)
  90:memory.h      **** #define PG_Active	(1 << 4)  //16
  91:memory.h      **** 
  92:memory.h      **** //The page data is up-to-date.
  93:memory.h      **** #define PG_Up_To_Date	(1 << 5) //32
  94:memory.h      **** 
  95:memory.h      **** //Device memory page
  96:memory.h      **** #define PG_Device	(1 << 6) //64
  97:memory.h      **** 
  98:memory.h      **** //Pages used by the kernel
  99:memory.h      **** #define PG_Kernel	(1 << 7) //128
 100:memory.h      **** 
 101:memory.h      **** //Pages shared by the kernel to the user space
 102:memory.h      **** #define PG_K_Share_To_U	(1 << 8)  //256
 103:memory.h      **** 
 104:memory.h      **** //The pages used by the slab allocator
 105:memory.h      **** #define PG_Slab		(1 << 9)  //512
