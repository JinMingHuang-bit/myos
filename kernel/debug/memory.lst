  71:memory.c      **** 	
  72:memory.c      **** 	/*
  73:memory.c      **** step 1: 2MB pages
  74:memory.c      **** (TotalMem >> PAGE_2M_SHIFT)
  75:memory.c      **** ↓
  76:memory.c      **** The 2MB pages that need to be managed
  77:memory.c      **** 
  78:memory.c      **** Step 2: Round up from bits to bytes
  79:memory.c      **** (pages + 7) / 8
  80:memory.c      **** ↓
  81:memory.c      **** Each byte stores the status of 8 pages.
GAS LISTING memory.s 			page 85


  82:memory.c      **** +7 is for rounding up to the nearest whole number.
  83:memory.c      **** 
  84:memory.c      **** Step 3: Byte → Long Alignment
  85:memory.c      **** 
  86:memory.c      **** & (~(sizeof(long) - 1))
  87:memory.c      **** ↓
  88:memory.c      **** ~7 = 0xffff...fff8（assume 64 bits long）
  89:memory.c      **** & 0xffff...fff8
  90:memory.c      **** ↓
  91:memory.c      **** Align to the 8-byte boundary (sizeof(long) = 8)
  92:memory.c      **** Complete example:
  93:memory.c      **** 
  94:memory.c      **** total memory 4GB = 2048 pages
  95:memory.c      **** ↓
  96:memory.c      **** (2048 + 7) / 8 = 256 bytes
  97:memory.c      **** ↓
  98:memory.c      **** 256 & ~7 = 256（Alignment completed）
  99:memory.c      **** Why align to sizeof(long)?
 100:memory.c      **** Bitmap operations are usually performed in units of unsigned long (processing 64 pages at a time fo
 101:memory.c      **** Alignment can avoid performance losses caused by non-aligned accesses
 102:memory.c      **** 	 */
