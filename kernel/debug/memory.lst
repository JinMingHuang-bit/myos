 3723              	# memory.c:96: 	memory_management_struct.bits_length=(((unsigned long)(TotalMem>>PAGE_2M_SHIFT)+siz
  66:memory.c      **** 	/*
  67:memory.c      **** 步骤 1：页数
  68:memory.c      **** (TotalMem >> PAGE_2M_SHIFT)
  69:memory.c      **** ↓
  70:memory.c      **** 需要管理的 2MB 页数
  71:memory.c      **** 步骤 2：位 → 字节向上取整
  72:memory.c      **** 
  73:memory.c      **** (页数 + 7) / 8
  74:memory.c      **** ↓
  75:memory.c      **** 每个字节存储 8 个页的状态
  76:memory.c      **** +7 是为了向上取整
  77:memory.c      **** 步骤 3：字节 → long 对齐
  78:memory.c      **** 
  79:memory.c      **** & (~(sizeof(long) - 1))
  80:memory.c      **** ↓
  81:memory.c      **** ~7 = 0xffff...fff8（假设 64 位 long）
  82:memory.c      **** & 0xffff...fff8
  83:memory.c      **** ↓
  84:memory.c      **** 向下对齐到 8 字节边界（sizeof(long) = 8）
  85:memory.c      **** 完整示例：
  86:memory.c      **** 
  87:memory.c      **** 总内存 4GB = 2048 页
  88:memory.c      **** ↓
  89:memory.c      **** (2048 + 7) / 8 = 256 字节
  90:memory.c      **** ↓
  91:memory.c      **** 256 & ~7 = 256（已对齐）
  92:memory.c      **** 为什么对齐到 sizeof(long)？
  93:memory.c      **** 位图操作通常是按 unsigned long 为单位（64 位一次处理 64 个页）
  94:memory.c      **** 对齐后可以避免非对齐访问导致的性能损失
  95:memory.c      **** 	 */
  96:memory.c      **** 	memory_management_struct.bits_length=(((unsigned long)(TotalMem>>PAGE_2M_SHIFT)+sizeof(long)*8-1)/
