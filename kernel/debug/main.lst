  12:memory.h      **** /* 
  13:memory.h      **** 地址翻译流程：
  14:memory.h      **** 1. CR3寄存器 → PML4物理基址
  15:memory.h      **** 2. PML4索引 → 在PML4中找到PDPT的物理地址
  16:memory.h      **** 3. PDPT索引 → 在PDPT中找到PD的物理地址  
  17:memory.h      **** 4. PD索引 → 在PD中找到PT的物理地址
  18:memory.h      **** 5. PT索引 → 在PT中找到物理页框地址
  19:memory.h      **** 6. 偏移量 → 物理地址中的具体位置
  20:memory.h      **** 
  21:memory.h      **** 在x86_64架构中，标准的48位虚拟地址布局如下：
  22:memory.h      **** 
  23:memory.h      **** 47               39 38               30 29               21 20               12 11        0
  24:memory.h      **** ┌────────────────┬───────────────
  25:memory.h      **** │    PML4索引    │    PDPT索引     │     PD索引     │     PT索引     │     偏移
  26:memory.h      **** │    (9 bits)    │    (9 bits)    │    (9 bits)    │    (9 bits)    │    (12 bits)    │
  27:memory.h      **** └────────────────┴───────────────
  28:memory.h      ****        ↑                 ↑                 ↑                 ↑                ↑
  29:memory.h      ****       47-39            38-30             29-21             20-12            11-0
  30:memory.h      **** 
  31:memory.h      **** 	因此,为了从64位虚拟地址中提取出最高9位（PML4索引），需要右移39位来去�
  32:memory.h      **** 	下面的代码类似
  33:memory.h      **** */
  34:memory.h      **** #define PAGE_GDT_SHIFT 39
  35:memory.h      **** #define PAGE_1G_SHIFT 30
  36:memory.h      **** #define PAGE_2M_SHIFT 21
  37:memory.h      **** //2的12次方 4096,即4k,这些是每种页表项代表的物理页容量
  38:memory.h      **** #define PAGE_4K_SHIFT 12
  39:memory.h      **** //1UL：无符号长整型常量1（64位）
  40:memory.h      **** //2,097,152,即2M
  41:memory.h      **** #define PAGE_2M_SIZE (1UL << PAGE_2M_SHIFT)
  42:memory.h      **** //1UL << 12 = 4,096 = 4KB。
  43:memory.h      **** #define PAGE_4K_SIZE (1UL << PAGE_4K_SHIFT)
  44:memory.h      **** //这个掩码与任何地址进行“与”操作，都会将地址的低21位清零，从而得�
  45:memory.h      **** #define PAGE_2M_MASK (~(PAGE_2M_SIZE - 1))
  46:memory.h      **** #define PAGE_4K_MASK (~(PAGE_4K_SIZE - 1))
  47:memory.h      **** /* 
  48:memory.h      **** 设 a = q·s + r，其中 0 ≤ r < s（r 是余数）
  49:memory.h      **** 情况 1: r = 0（已对齐）
  50:memory.h      **** (a + s - 1) & ~(s-1) 
  51:memory.h      **** = (q·s + s - 1) & ~(s-1)
  52:memory.h      **** = ((q+1)·s - 1) & ~(s-1)
  53:memory.h      **** = q·s   // 因为(q+1)·s-1的低位都是1，与~（s-1）与后保留高位
  54:memory.h      **** 情况 2: r > 0（未对齐）
GAS LISTING main.s 			page 66


  55:memory.h      **** (a + s - 1) & ~(s-1)
  56:memory.h      **** = (q·s + r + s - 1) & ~(s-1)
  57:memory.h      **** = ((q+1)·s + (r-1)) & ~(s-1)
  58:memory.h      **** = (q+1)·s  // 因为r-1 < s-1，清除低位后得到(q+1)·s
  59:memory.h      **** */
  60:memory.h      **** #define PAGE_2M_ALIGN(addr) (((unsigned long)(addr) + PAGE_2M_SIZE - 1) & PAGE_2M_MASK)
  61:memory.h      **** #define PAGE_4K_ALIGN(addr) (((unsigned long)(addr) + PAGE_4K_SIZE - 1) & PAGE_4K_MASK)
  62:memory.h      **** #define Virt_To_Phy(addr) ((unsigned long)(addr) - PAGE_OFFSET)
  63:memory.h      **** #define Phy_To_Virt(addr) ((unsigned long*)((unsigned long)(addr) + PAGE_OFFSET))
