  16:gate.h        **** // set the interrupt gate
  17:gate.h        **** /*
  18:gate.h        **** This macro function is used to set the interrupt gate descriptor for the x86-64 architecture.
  19:gate.h        **** Parameter descriptions:
  20:gate.h        **** - gate_selector_addr: The memory address of the interrupt gate descriptor
  21:gate.h        **** - attr: The attribute bits of the interrupt gate
  22:gate.h        **** - ist: The index of the interrupt stack table
  23:gate.h        **** - code_addr: The code address of the interrupt handler program 
  24:gate.h        **** x86-64 interrupt gate descriptor format (16 bytes):
  25:gate.h        **** +0-7 bytes: Low 64 bits - including the 0-31 bits of the code address, segment selector, IST, etc.
  26:gate.h        **** +8-15 bytes: High 64 bits - including the 32-63 bits of the code address, attributes, etc.
  27:gate.h        **** */
  28:gate.h        **** /*&a：Using the rax/eax registers, early breaking of constraints*/ 
  29:gate.h        **** /*&d：Using the rdx/edx registers, early breaking of constraints*/ 
  30:gate.h        **** 
  31:gate.h        **** // #define _set_gate(gate_selector_addr, attr, ist, code_addr) \
  32:gate.h        **** // do \
  33:gate.h        **** // { \
  34:gate.h        **** //     unsigned long __d0, __d1; \
  35:gate.h        **** //     __asm__ __volatile__( \
  36:gate.h        **** //         "movw %%dx, %%ax  \n\t"          /* Move the dx (segment selector) to ax */ \
  37:gate.h        **** //         "andq $0x7, %%rcx \n\t"          /* Keep the last three bits of IST*/ \
  38:gate.h        **** //         "addq %4, %%rcx   \n\t"           \
  39:gate.h        **** //         "shlq $32, %%rcx  \n\t"          /* Shift left by 32 bits to prepare for the higher bits
GAS LISTING main.s 			page 60


  40:gate.h        **** //         "addq %%rcx, %%rax \n\t"         /* Merge into rax*/ \
  41:gate.h        **** //         "xorq %%rcx, %%rcx \n\t"         /* Clear rcx */ \
  42:gate.h        **** //         "movl %%edx, %%ecx \n\t"         /*Move the lower 32 bits of edx to ecx */ \
  43:gate.h        **** //         "shrq $16, %%rcx  \n\t"          /* Shift right by 16 bits to obtain the high 16 bits. *
  44:gate.h        **** //         "shlq $48, %%rcx  \n\t"          /* Shift left by 48 positions to the most significant b
  45:gate.h        **** //         "addq %%rcx, %%rax \n\t"         /* Add to rax */ \
  46:gate.h        **** //         "movq %%rax, %0    \n\t"         /* Store the lower 64 bits */ \
  47:gate.h        **** //         "shrq $32, %%rdx  \n\t"          /* Shift the rdx register 32 bits to the right. */ \
  48:gate.h        **** //         "movq %%rdx, %1    \n\t"         /* Store the high 64 bits*/ \
  49:gate.h        **** //         : "=m"(*((unsigned long*)(gate_selector_addr))),  /*=m：Memory operand, writable*/ \
  50:gate.h        **** //           "=m"(*(1 + (unsigned long *)(gate_selector_addr))), \
  51:gate.h        **** //           "=&a"(__d0), "=&d"(__d1) \
  52:gate.h        **** //         : "i"(attr << 8), \
  53:gate.h        **** //           "3"((unsigned long)(code_addr)), \
  54:gate.h        **** //           "2"(0x8 << 16), \
  55:gate.h        **** //           "c"(ist)     /*rcx */ \
  56:gate.h        **** //         :  "memory"); \
  57:gate.h        **** // } while(0)
  58:gate.h        **** 
  59:gate.h        **** #define _set_gate(gate_selector_addr, attr, ist, code_addr) \
  60:gate.h        **** do \
  61:gate.h        **** { \
  62:gate.h        ****     unsigned long __d0, __d1; \
  63:gate.h        ****     __asm__ __volatile__( \
  64:gate.h        ****         "movw %%dx, %%ax  \n\t"          /* Move the dx (segment selector) to ax */ \
  65:gate.h        ****         "andq $0x7, %%rcx \n\t"          /* Keep the last three bits of IST*/ \
  66:gate.h        ****         "addq %4, %%rcx   \n\t"          \
  67:gate.h        ****         "shlq $32, %%rcx  \n\t"          /* Shift left by 32 bits to prepare for the higher bits */
  68:gate.h        ****         "addq %%rcx, %%rax \n\t"         /* Merge into rax*/ \
  69:gate.h        ****         "xorq %%rcx, %%rcx \n\t"         /* Clear rcx */ \
  70:gate.h        ****         "movl %%edx, %%ecx \n\t"         /*Move the lower 32 bits of edx to ecx */ \
  71:gate.h        ****         "shrq $16, %%rcx  \n\t"          /* Shift right by 16 bits to obtain the high 16 bits. */ \
  72:gate.h        ****         "shlq $48, %%rcx  \n\t"          /* Shift left by 48 positions to the most significant bit.
  73:gate.h        ****         "addq %%rcx, %%rax \n\t"         /* Add to rax */ \
  74:gate.h        ****         "movq %%rax, %0    \n\t"         /* Store the lower 64 bits */ \
  75:gate.h        ****         "shrq $32, %%rdx  \n\t"          /* Shift the rdx register 32 bits to the right. */ \
  76:gate.h        ****         "movq %%rdx, %1    \n\t"         /* Store the high 64 bits*/ \
  77:gate.h        ****         : "=m"(*(0 + (unsigned long*)(gate_selector_addr))),  /*=m：Memory operand, writable*/ \
  78:gate.h        ****           "=m"(*(1 + (unsigned long *)(gate_selector_addr))), \
  79:gate.h        ****           "=&a"(__d0), "=&d"(__d1) \
  80:gate.h        ****         : "i"(attr << 8), \
  81:gate.h        ****           "3"((unsigned long)(code_addr)), \
  82:gate.h        ****           "2"(0x8 << 16), \
  83:gate.h        ****           "c"(ist)     /*rcx */ \
  84:gate.h        ****         :  "memory"); \
  85:gate.h        **** } while(0)
  86:gate.h        **** 
  87:gate.h        **** /*
  88:gate.h        **** Input 0: "i" (attr << 8) 
  89:gate.h        **** i: Instant count 
  90:gate.h        **** attr << 8: Shift the attribute 8 bits to the left to prepare for subsequent bit operations. 
  91:gate.h        **** Input 1: "3"((unsigned long)(code_addr)) 
  92:gate.h        **** 3: Match the third output operand ("=&d"(__d1)) 
  93:gate.h        **** Put the code address in the rdx register. 
  94:gate.h        **** Input 2: "2" (0x8 << 16) 
  95:gate.h        **** 2: Match the second output operand ("=&a"(__d0)) 
  96:gate.h        **** 0x8 << 16: Kernel code segment selector shifted left by 16 bits
GAS LISTING main.s 			page 61


  97:gate.h        **** */ 
  98:gate.h        **** 
  99:gate.h        **** 
 100:gate.h        **** 
 101:gate.h        **** #define load_TR(n) \
 102:gate.h        **** do {              \
 103:gate.h        ****   __asm__ __volatile__( "ltr %%ax" \
 104:gate.h        ****     :         \
 105:gate.h        ****     : "a"(n << 3) \
 106:gate.h        ****     : "memory" );    \
 107:gate.h        **** }while (0)
 108:gate.h        **** 
 109:gate.h        **** 
 110:gate.h        **** // Usage Examples and Explanations /*
 111:gate.h        **** /*Interrupt Descriptor Structure:
 112:gate.h        **** - Lower 64 bits (0-7 bytes): [0-15] code address [0-15] + [16-31] segment selector + [32-47] IST + 
 113:gate.h        **** - Upper 64 bits (8-15 bytes): [0-31] code address [32-63] + [40-47] attributes + [56-63] reserved b
 114:gate.h        **** This macro is mainly used to set the descriptor of the interrupt handler in the kernel.
 115:gate.h        **** It is a key function for setting the IDT (Interrupt Descriptor Table) in the development of the ope
 116:gate.h        **** 
 117:gate.h        **** 
 118:gate.h        **** 
 119:gate.h        **** static inline void set_intr_gate(unsigned int n, unsigned char ist,void * addr){
 120:gate.h        ****     _set_gate(IDT_Table+n, 0x8E, ist, addr);
 121:gate.h        **** }
 122:gate.h        **** /*
 123:gate.h        **** Why is static needed?
 124:gate.h        **** The problem:
 125:gate.h        **** When you define an inline function in a header file but do not add static: 
 126:gate.h        **** Multiple .c files #include this header file 
 127:gate.h        **** Each .c file will obtain the definition of the function. 
 128:gate.h        **** During the linking process, the following issues may occur: 
 129:gate.h        **** Re-definition error (if the compiler generates a function body) 
 130:gate.h        **** Undefined reference (if the compiler only inlined part of the call) 
 131:gate.h        **** Depending on the implementation of the compiler 
 132:gate.h        **** Compiler behavior differences:
 133:gate.h        **** GCC: Inline functions default to external linkage, unless declared as static. 
 134:gate.h        **** Different compilation standards and versions may exhibit different behaviors. 
 135:gate.h        **** In the Linux kernel, the keyword "static inline" is commonly used.
 136:gate.h        **** */
 137:gate.h        **** 
 138:gate.h        **** static inline void set_trap_gate(unsigned int n, unsigned char ist,void * addr){
 139:gate.h        **** 
 140:gate.h        ****     _set_gate(IDT_Table+n, 0x8F, ist, addr);
 141:gate.h        **** 
 142:gate.h        **** }
 143:gate.h        **** 
 144:gate.h        **** static inline void set_system_gate(unsigned int n, unsigned char ist,void * addr){
 145:gate.h        ****     _set_gate(IDT_Table+n, 0xEF, ist, addr);
 146:gate.h        **** }
 147:gate.h        **** 
 148:gate.h        **** static inline void set_system_intr_gate(unsigned int n,unsigned char ist,void * addr)	//int3
 149:gate.h        **** {
 150:gate.h        **** 	_set_gate(IDT_Table + n , 0xEE , ist , addr);	//P,DPL=3,TYPE=E
 151:gate.h        **** }
