  65:gate.h        ****         "andq $0x7, %%rcx \n\t"          /* Keep the last three bits of IST*/ \
  66:gate.h        ****         "addq %4, %%rcx   \n\t"          \
  67:gate.h        ****         "shlq $32, %%rcx  \n\t"          /* Shift left by 32 bits to prepare for the higher bits */
  68:gate.h        ****         "addq %%rcx, %%rax \n\t"         /* Merge into rax*/ \
  69:gate.h        ****         "xorq %%rcx, %%rcx \n\t"         /* Clear rcx */ \
  70:gate.h        ****         "movl %%edx, %%ecx \n\t"         /*Move the lower 32 bits of edx to ecx */ \
  71:gate.h        ****         "shrq $16, %%rcx  \n\t"          /* Shift right by 16 bits to obtain the high 16 bits. */ \
  72:gate.h        ****         "shlq $48, %%rcx  \n\t"          /* Shift left by 48 positions to the most significant bit.
  73:gate.h        ****         "addq %%rcx, %%rax \n\t"         /* Add to rax */ \
  74:gate.h        ****         "movq %%rax, %0    \n\t"         /* Store the lower 64 bits */ \
  75:gate.h        ****         "shrq $32, %%rdx  \n\t"          /* Shift the rdx register 32 bits to the right. */ \
