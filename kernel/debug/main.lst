  16:gate.h        **** // set the interrupt gate
  17:gate.h        **** /*
  18:gate.h        **** 这个宏函数用于设置x86-64架构的中断门描述符(Interrupt Gate Descriptor)
  19:gate.h        **** 参数说明：
  20:gate.h        **** - gate_selector_addr: 中断门描述符的内存地址
  21:gate.h        **** - attr: 中断门的属性位
  22:gate.h        **** - ist: 中断栈表索引
  23:gate.h        **** - code_addr: 中断处理程序的代码地址
  24:gate.h        **** 
  25:gate.h        **** x86-64中断门描述符格式（16字节）：
  26:gate.h        **** +0-7字节：低64位 - 包含代码地址的0-31位、段选择子、IST等
  27:gate.h        **** +8-15字节：高64位 - 包含代码地址的32-63位、属性等
  28:gate.h        **** */
  29:gate.h        **** 
  30:gate.h        **** #define _set_gate(gate_selector_addr, attr, ist, code_addr) \
  31:gate.h        **** do \
  32:gate.h        **** { \
  33:gate.h        ****     unsigned long __d0, __d1; \
  34:gate.h        ****     __asm__ __volatile__( \
  35:gate.h        ****         "movw %%dx, %%ax  \n\t"          /* 将dx(段选择子)移到ax */ \
  36:gate.h        ****         "andq $0x7, %%rcx \n\t"          /* 保留IST的低3位 */ \
  37:gate.h        ****         "addq %4, %%rcx   \n\t"           \
  38:gate.h        ****         "shlq $32, %%rcx  \n\t"          /* 左移32位准备高位 */ \
  39:gate.h        ****         "addq %%rcx, %%rax \n\t"         /* 合并到rax */ \
GAS LISTING main.s 			page 60


  40:gate.h        ****         "xorq %%rcx, %%rcx \n\t"         /* 清空rcx */ \
  41:gate.h        ****         "movl %%edx, %%ecx \n\t"         /* 将edx低32位移到ecx */ \
  42:gate.h        ****         "shrq $16, %%rcx  \n\t"          /* 右移16位获取高16位 */ \
  43:gate.h        ****         "shlq $48, %%rcx  \n\t"          /* 左移48位到最高位 */ \
  44:gate.h        ****         "addq %%rcx, %%rax \n\t"         /* 添加到rax */ \
  45:gate.h        ****         "movq %%rax, %0    \n\t"         /* 存储低64位 */ \
  46:gate.h        ****         "shrq $32, %%rdx  \n\t"          /* 将rdx右移32位 */ \
  47:gate.h        ****         "movq %%rdx, %1    \n\t"         /* 存储高64位 */ \
  48:gate.h        ****         : "=m"(*((unsigned long*)(gate_selector_addr))),  /*=m：内存操作数，可写*/ \
  49:gate.h        ****           "=m"(*(1 + (unsigned long *)(gate_selector_addr))),   /*&a：使用rax/eax寄存器，早
  50:gate.h        ****           &d：使用rdx/edx寄存器，早期破坏约束*/\ 
  51:gate.h        ****           "=&a"(__d0), "=&d"(__d1) \
  52:gate.h        ****         : "i"(attr << 8), \
  53:gate.h        ****           "3"((unsigned long)(code_addr)), \
  54:gate.h        ****           "2"(0x8 << 16), \
  55:gate.h        ****           "c"(ist)     /*rcx */ \
  56:gate.h        ****         :  "memory"); \
  57:gate.h        **** } while(0)
  58:gate.h        **** 
  59:gate.h        **** /*
  60:gate.h        **** 输入0："i"(attr << 8)
  61:gate.h        **** 
  62:gate.h        **** i：立即数
  63:gate.h        **** 
  64:gate.h        **** attr << 8：属性左移8位，为后续位操作做准备
  65:gate.h        **** 
  66:gate.h        **** 输入1："3"((unsigned long)(code_addr))
  67:gate.h        **** 
  68:gate.h        **** 3：匹配第3个输出操作数（"=&d"(__d1)）
  69:gate.h        **** 
  70:gate.h        **** 代码地址放入rdx寄存器
  71:gate.h        **** 
  72:gate.h        **** 输入2："2"(0x8 << 16)
  73:gate.h        **** 
  74:gate.h        **** 2：匹配第2个输出操作数（"=&a"(__d0)）
  75:gate.h        **** 
  76:gate.h        **** 0x8 << 16：内核代码段选择子左移16位
  77:gate.h        **** 
  78:gate.h        **** */ 
  79:gate.h        **** 
  80:gate.h        **** 
  81:gate.h        **** 
  82:gate.h        **** #define load_TR(n) \
  83:gate.h        **** do {              \
  84:gate.h        ****   __asm__ __volatile__( "ltr %%ax" \
  85:gate.h        ****     :         \
  86:gate.h        ****     : "a"(n << 3) \
  87:gate.h        ****     : "memory" );    \
  88:gate.h        **** }while (0)
  89:gate.h        **** 
  90:gate.h        **** 
  91:gate.h        **** // 使用示例和解释
  92:gate.h        **** /*
  93:gate.h        **** 中断门描述符结构：
  94:gate.h        **** - 低64位（0-7字节）：[0-15]代码地址[0-15] + [16-31]段选择子 + [32-47]IST + [48-63]�
  95:gate.h        **** - 高64位（8-15字节）：[0-31]代码地址[32-63] + [40-47]属性 + [56-63]保留位
  96:gate.h        **** 
