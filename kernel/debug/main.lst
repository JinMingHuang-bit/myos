 106:gate.h        **** /*
 107:gate.h        **** 为什么需要加 static？
 108:gate.h        **** 问题所在：
 109:gate.h        **** 当你在头文件中定义了一个 inline 函数但不加 static：
 110:gate.h        **** 
 111:gate.h        **** 多个 .c 文件 #include 这个头文件
 112:gate.h        **** 
 113:gate.h        **** 每个 .c 文件都会获得函数的定义
 114:gate.h        **** 
 115:gate.h        **** 链接时可能会出现：
 116:gate.h        **** 
 117:gate.h        **** 重复定义错误（如果编译器生成了函数体）
 118:gate.h        **** 
 119:gate.h        **** 未定义引用（如果编译器只内联了部分调用）
 120:gate.h        **** 
 121:gate.h        **** 因编译器实现而异
 122:gate.h        **** 
 123:gate.h        **** 编译器行为差异：
 124:gate.h        **** GCC：inline 函数默认具有外部链接，除非被声明为 static
 125:gate.h        **** 
 126:gate.h        **** 不同编译标准和版本可能有不同行为
 127:gate.h        **** 
 128:gate.h        **** 在 Linux 内核中，通常使用 static inline
 129:gate.h        **** 
 130:gate.h        **** 
 131:gate.h        **** */
 132:gate.h        **** 
 133:gate.h        **** static inline void set_trap_gate(unsigned int n, unsigned char ist,void * addr){
 134:gate.h        **** 
 135:gate.h        ****     _set_gate(IDT_Table+n, 0x8F, ist, addr);
 136:gate.h        **** 
 137:gate.h        **** }
