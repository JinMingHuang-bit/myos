 139:gate.h        **** static inline void set_system_gate(unsigned int n, unsigned char ist,void * addr){
 140:gate.h        ****     _set_gate(IDT_Table+n, 0xEF, ist, addr);
 141:gate.h        **** }
 142:gate.h        **** 
 143:gate.h        **** static inline void set_system_intr_gate(unsigned int n,unsigned char ist,void * addr)	//int3
 144:gate.h        **** {
 145:gate.h        **** 	_set_gate(IDT_Table + n , 0xEE , ist , addr);	//P,DPL=3,TYPE=E
 146:gate.h        **** }
