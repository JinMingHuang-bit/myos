   549                                  ;=======	load GDTR
   550                                  	
   551 00000078 0F0115[18000000]        	lgdt	[GdtPtr64]
   552                                  	;set data segment selector to 0x10, which is the offset of the 64-bit data segment descriptor in the GDT.
   553 0000007F 66B81000                	mov	ax,	0x10
   554 00000083 8ED8                    	mov	ds,	ax
   555 00000085 8EC0                    	mov	es,	ax
   556 00000087 8EE0                    	mov	fs,	ax
   557 00000089 8EE8                    	mov	gs,	ax
   558 0000008B 8ED0                    	mov	ss,	ax
   559                                  
   560 0000008D BC007E0000              	mov	esp,	7E00h
   561                                  	
   562                                  ;Enable PAE (Physical Address Extension). 
   563                                  ;PAE is a necessary condition for entering long mode, allowing access to more than 4GB of physical memory.
   564                                  
   565 00000092 0F20E0                  	mov	eax,	cr4
   566 00000095 0FBAE805                	bts	eax,	5
   567 00000099 0F22E0                  	mov	cr4,	eax
   568                                  
   569                                  ;Load the physical address of the page table, 0x90000, into the CR3 register.
   570                                  ;The CPU begins the conversion from virtual addresses to physical addresses from this address.
   571 0000009C B800000900              	mov	eax,	0x90000
   572 000000A1 0F22D8                  	mov	cr3,	eax
   573                                  
   574                                  ;=======	enable long-mode
   575                                  	;Enable long mode through the IA32_EFER MSR (Model Specific Register)
   576 000000A4 B9800000C0              	mov	ecx,	0C0000080h		; IA32_EFER number
   577                                  	; Read MSR into EDX:EAX
   578 000000A9 0F32                    	rdmsr
   579                                  	; Set the 8th bit (LME bit)
   580 000000AB 0FBAE808                	bts	eax,	8
   581                                  	; Reply to MSR
   582 000000AF 0F30                    	wrmsr
   583                                  
   584                                  ;=======	open PE and paging
   585                                  
   586 000000B1 0F20C0                  	mov	eax,	cr0 
   587 000000B4 0FBAE800                	bts	eax,	0 ; Set the 0th bit (the PE bit, enabling the protected mode)
   588 000000B8 0FBAE81F                	bts	eax,	31 ; Set the 31st bit (the PG bit, page enable)
   589                                  	;Both of these bits must be set simultaneously,
   590                                  	;because when switching from protected mode to long mode, paging must be enabled immediately.
   591                                  	;0x10430
   592 000000BC 0F22C0                  	mov	cr0,	eax ; write to cr0
   593                                  	;0x10433
   594 000000BF EA000010000800          	jmp	SelectorCode64:OffsetOfKernelFile
