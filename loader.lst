    14                                  [SECTION gdt]
    15                                  ; The first descriptor of GDT must be empty (all zeros), which is a requirement set by Intel.
    16 00000000 0000000000000000        LABEL_GDT:		dd	0,0
    17                                  ; A 32-bit code segment (base address 0, limit 4GB, privilege level 0, executable and readable)
    18 00000008 FFFF0000009ACF00        LABEL_DESC_CODE32:	dd	0x0000FFFF,0x00CF9A00
    19                                  ; A 32-bit data segment (base address 0, limit 4GB, privilege level 0, readable and writable)
    20 00000010 FFFF00000092CF00        LABEL_DESC_DATA32:	dd	0x0000FFFF,0x00CF9200
    21                                  ; Calculate the byte length of GDT, $= current address, LABEL_GDT= start address of GDT, 
    22                                  ;the difference is the total bytes of GDT (3 descriptors × 8 bytes = 24 bytes)
    23                                  GdtLen	equ	$ - LABEL_GDT
    24 00000018 1700                    GdtPtr	dw	GdtLen - 1
    25 0000001A [00000000]              	dd	LABEL_GDT	
    26                                  ;Subtract the addresses to obtain the offset. Each data occupies 8 bytes, 
    27                                  ;so the first one is 0x08 and the second one is 0x10 (which is 16)
    28                                  SelectorCode32	equ	LABEL_DESC_CODE32 - LABEL_GDT
    29                                  SelectorData32	equ	LABEL_DESC_DATA32 - LABEL_GDT
    30                                  
    31                                  [SECTION gdt64]
    32                                  
    33 00000000 0000000000000000        LABEL_GDT64:		dq	0x0000000000000000
    34                                  ;P (Existence Bit) = 1, DPL (Descriptor Privilege Level) = 0
    35                                  ;S (Descriptor Type) = 1 (Code/Data Segment), Type = 1000 (Executable, Non-Consistent, Non-readable),
    36                                  ; L (64-bit Code Segment Flag) = 1, D = 0 (In long mode, for code segments, the D bit should be set to 0)
    37 00000008 0000000000982000        LABEL_DESC_CODE64:	dq	0x0020980000000000
    38                                  ;P = 1, DPL = 0, S = 1, Type = 0010 (read/write, upward expansion), L = 0 (in long mode, the L bit of the data segment must be 0)
    39 00000010 0000000000920000        LABEL_DESC_DATA64:	dq	0x0000920000000000
    40                                  
    41                                  GdtLen64	equ	$ - LABEL_GDT64
    42 00000018 1700                    GdtPtr64	dw	GdtLen64 - 1
    43 0000001A [00000000]              		dd	LABEL_GDT64
    44                                  ;0x08
    45                                  SelectorCode64	equ	LABEL_DESC_CODE64 - LABEL_GDT64
    46                                  ;0x10
    47                                  SelectorData64	equ	LABEL_DESC_DATA64 - LABEL_GDT64
