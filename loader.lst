   547                                  ;=======	load GDTR
   548                                  	
   549 00000078 0F0115[18000000]        	lgdt	[GdtPtr64]
   550                                  	;set data segment selector to 0x10, which is the offset of the 64-bit data segment descriptor in the GDT.
   551 0000007F 66B81000                	mov	ax,	0x10
   552 00000083 8ED8                    	mov	ds,	ax
   553 00000085 8EC0                    	mov	es,	ax
   554 00000087 8EE0                    	mov	fs,	ax
   555 00000089 8EE8                    	mov	gs,	ax
   556 0000008B 8ED0                    	mov	ss,	ax
   557                                  
   558 0000008D BC007E0000              	mov	esp,	7E00h
   559                                  ;Enable PAE (Physical Address Extension). 
   560                                  ;PAE is a necessary condition for entering long mode, allowing access to more than 4GB of physical memory.
   561 00000092 0F20E0                  	mov	eax,	cr4
   562 00000095 0FBAE805                	bts	eax,	5
   563 00000099 0F22E0                  	mov	cr4,	eax
   564                                  ;Load the physical address of the page table, 0x90000, into the CR3 register.
   565                                  ;The CPU begins the conversion from virtual addresses to physical addresses from this address.
   566 0000009C B800000900              	mov	eax,	0x90000
   567 000000A1 0F22D8                  	mov	cr3,	eax
   568                                  ;=======	enable long-mode
   569                                  	;Enable long mode through the IA32_EFER MSR (Model Specific Register)
   570 000000A4 B9800000C0              	mov	ecx,	0C0000080h		; IA32_EFER number
   571                                  	; Read MSR into EDX:EAX
   572 000000A9 0F32                    	rdmsr
   573                                  	; Set the 8th bit (LME bit)
   574 000000AB 0FBAE808                	bts	eax,	8
   575                                  	; Reply to MSR
   576 000000AF 0F30                    	wrmsr
   577                                  ;=======	open PE and paging
   578 000000B1 0F20C0                  	mov	eax,	cr0 
   579 000000B4 0FBAE800                	bts	eax,	0 ; Set the 0th bit (the PE bit, enabling the protected mode)
   580 000000B8 0FBAE81F                	bts	eax,	31 ; Set the 31st bit (the PG bit, page enable)
   581                                  	;Both of these bits must be set simultaneously,
   582                                  	;because when switching from protected mode to long mode, paging must be enabled immediately.
   583                                  	;0x10430
   584 000000BC 0F22C0                  	mov	cr0,	eax ; write to cr0
   585                                  	;0x10433
   586 000000BF EA000010000800          	jmp	SelectorCode64:OffsetOfKernelFile
