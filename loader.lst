   690 00000134 B801000080              	mov eax, 0x80000001
   691 00000139 0FA2                    	cpuid
   692 0000013B 0FBAE21D                	bt edx, 29
   693                                  	;Set if Carry) :
   694                                  ;If CF=1 (that is, EDX[29]=1, long mode is supported), then AL=1.
   695                                  ;Otherwise AL is equal to 0.
   696 0000013F 0F92C0                  	setc al
