   596                                  ;=======	test support long mode or not
   597                                  
   598                                  support_long_mode:
   599                                  
   600 000000C6 B800000080              	mov	eax,	0x80000000
   601                                  	;The CPUID command returns the following value:
   602                                  	;EAX = maximum supported extension number (e.g., EAX >= 0x80000001 if 0x80000001 is supported
   603 000000CB 0FA2                    	cpuid
   604 000000CD 3D01000080              	cmp	eax,	0x80000001
   605                                  	;;Set if Not Below
   606 000000D2 0F93C0                  	setnb	al	
   607                                  	;If EAX >= 0x80000001 (that is, extended functionality is supported), AL=1.
   608                                  	;Otherwise AL is equal to 0.
   609                                  	;bt (Bit Test) :
   610                                  	;The 29th Bit (counting from 0) of the EDX register is tested, which is the long mode support bit (LM Bit).
   611                                  	;The result is stored in CF (Carry Flag).
   612 000000D5 720E                    	jb	support_long_mode_done
   613 000000D7 B801000080              	mov	eax,	0x80000001
   614 000000DC 0FA2                    	cpuid
   615 000000DE 0FBAE21D                	bt	edx,	29
   616                                  	;Set if Carry):
   617                                  	;If CF=1 (that is, EDX[29]=1, long mode is supported), then AL=1.
   618                                  	;Otherwise AL is equal to 0.
   619 000000E2 0F92C0                  	setc	al
   620                                  support_long_mode_done:
   621                                  	
   622 000000E5 0FB6C0                  	movzx	eax,	al
   623 000000E8 C3                      	ret
   624                                  
