   684 0000012F 0F93C0                  	setnb al;Set if Not Below
   685                                  	;If EAX >= 0x80000001 (that is, extended functionality is supported), AL=1.
   686                                  	;Otherwise AL is equal to 0.
   687                                  	;bt (Bit Test) :
   688                                  	;The 29th Bit (counting from 0) of the EDX register is tested, which is the long mode support bit (LM Bit).
   689                                  	;The result is stored in CF (Carry Flag).
   690 00000132 720E                    	jb support_long_mode_done
   691 00000134 B801000080              	mov eax, 0x80000001
   692 00000139 0FA2                    	cpuid
   693 0000013B 0FBAE21D                	bt edx, 29
   694                                  	;Set if Carry) :
   695                                  ;If CF=1 (that is, EDX[29]=1, long mode is supported), then AL=1.
   696                                  ;Otherwise AL is equal to 0.
   697 0000013F 0F92C0                  	setc al
