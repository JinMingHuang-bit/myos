   588                                  ;=======	test support long mode or not
   589                                  
   590                                  support_long_mode:
   591                                  
   592 000000C6 B800000080              	mov	eax,	0x80000000
   593                                  	;The CPUID command returns the following value:
   594                                  	;EAX = maximum supported extension number (e.g., EAX >= 0x80000001 if 0x80000001 is supported
   595 000000CB 0FA2                    	cpuid
   596 000000CD 3D01000080              	cmp	eax,	0x80000001
   597                                  	;;Set if Not Below
   598 000000D2 0F93C0                  	setnb	al	
   599                                  	;If EAX >= 0x80000001 (that is, extended functionality is supported), AL=1.
   600                                  	;Otherwise AL is equal to 0.
   601                                  	;bt (Bit Test) :
   602                                  	;The 29th Bit (counting from 0) of the EDX register is tested, which is the long mode support bit (LM Bit).
   603                                  	;The result is stored in CF (Carry Flag).
   604 000000D5 720E                    	jb	support_long_mode_done
   605 000000D7 B801000080              	mov	eax,	0x80000001
   606 000000DC 0FA2                    	cpuid
   607 000000DE 0FBAE21D                	bt	edx,	29
   608                                  	;Set if Carry):
   609                                  	;If CF=1 (that is, EDX[29]=1, long mode is supported), then AL=1.
   610                                  	;Otherwise AL is equal to 0.
   611 000000E2 0F92C0                  	setc	al
   612                                  support_long_mode_done:
   613                                  	
   614 000000E5 0FB6C0                  	movzx	eax,	al
   615 000000E8 C3                      	ret
