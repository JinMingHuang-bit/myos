{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GDB Remote (Pause on Connect)",
            "type": "gdb",
            "request": "attach",
            "executable": "${workspaceFolder}/kernel/system.debug",
            "target": "localhost:1234",
            "remote": true,
            "stopAtConnect": true,   // 关键：连接后立即停止目标
            "cwd": "${workspaceRoot}",
            "gdbpath": "gdb"
        }
    ]
    }
        
        

    

