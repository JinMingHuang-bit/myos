    "version": "0.2.0",
    "configurations": [
        {
            "name": "GDB start",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/kernel/system.debug",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerServerAddress": "localhost:1234",
            "setupCommands": [
                {
                    "description": "Enable pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
        
        

    ]

}